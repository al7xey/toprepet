{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/assets/index-:hash.js",
      "destination": "https://toprepet.vercel.app/assets/index.js",
      "permanent": false
    },
    {
      "source": "/assets/index-:hash.css",
      "destination": "https://toprepet.vercel.app/assets/index.css",
      "permanent": false
    },
    {
      "source": "/assets/:path*",
      "has": [{ "type": "host", "value": "toprepet.ru" }],
      "destination": "https://toprepet.vercel.app/assets/:path*",
      "permanent": false
    },
    {
      "source": "/images/:path*",
      "has": [{ "type": "host", "value": "toprepet.ru" }],
      "destination": "https://toprepet.vercel.app/images/:path*",
      "permanent": false
    },
    {
      "source": "/favicon.svg",
      "has": [{ "type": "host", "value": "toprepet.ru" }],
      "destination": "https://toprepet.vercel.app/favicon.svg",
      "permanent": false
    },
    {
      "source": "/assets/:path*",
      "has": [{ "type": "host", "value": "www.toprepet.ru" }],
      "destination": "https://toprepet.vercel.app/assets/:path*",
      "permanent": false
    },
    {
      "source": "/images/:path*",
      "has": [{ "type": "host", "value": "www.toprepet.ru" }],
      "destination": "https://toprepet.vercel.app/images/:path*",
      "permanent": false
    },
    {
      "source": "/favicon.svg",
      "has": [{ "type": "host", "value": "www.toprepet.ru" }],
      "destination": "https://toprepet.vercel.app/favicon.svg",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
