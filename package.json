{
  "name": "toprepet",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:all": "pnpm dev",
    "build": "node scripts/sync-blog.mjs && tsc --noEmit && node scripts/verify-analytics.mjs && vite build && vite build --ssr src/app/entry-server.tsx --outDir dist-server && node scripts/prerender.mjs && node scripts/verify-seo.mjs",
    "start": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "lint": "oxlint src vite.config.ts vitest.config.ts playwright.config.ts e2e",
    "format": "oxfmt",
    "e2e": "playwright test",
    "build:e2e": "vite build --mode demo && vite build --mode demo --ssr src/app/entry-server.tsx --outDir dist-server && node scripts/prerender.mjs",
    "sync:blog": "node scripts/sync-blog.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@supabase/supabase-js": "2.117.0",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "browser-image-compression": "2.0.2",
    "lucide-react": "1.31.0",
    "parse5": "^8.0.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "^7.18.3",
    "transliteration": "2.6.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
  },
  "type": "module"
}
