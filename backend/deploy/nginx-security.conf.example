# Include/adapt inside the HTTPS API server. Bind gunicorn to a private socket/loopback.
client_max_body_size 11m;
client_body_timeout 10s;
client_header_timeout 10s;
send_timeout 30s;

# Never serve legacy documents or private storage statically.
location ^~ /media/documents/ { return 404; }
location ^~ /private-media/ { return 404; }

# Merge this into the API proxy location; do not add an unverified public proxy.
location / {
    proxy_pass http://127.0.0.1:8000;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_connect_timeout 5s;
    proxy_read_timeout 35s;
}
# Set TRUSTED_PROXY_CIDRS=127.0.0.1/32 only when nginx really is the immediate peer.
# Terminate TLS here; add edge request/connection limits appropriate to measured traffic.
